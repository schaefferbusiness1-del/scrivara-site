# Generated by `npm run build` from ../app.html. Committing it would create a
# second copy of the app that can drift from the first.
www/

# Build outputs and toolchain state.
node_modules/
*.log
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
ios/App/build/
ios/App/Pods/
ios/App/output/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
DerivedData/
*.ipa
*.aab
*.apk

# SIGNING MATERIAL. An upload key in git is an app hijack: anyone with it can
# publish an update to the owner's listing. Keep it in a password manager and
# in the CI secret store, nowhere else.
keystore.properties
*.keystore
*.jks
*.p12
*.mobileprovision
*.cer
AuthKey_*.p8

# Capacitor copies mobile/www into each native project on `cap sync`. Those are
# generated duplicates of a file that is itself generated; committing them
# would put three copies of the app in the repo, and the two nobody looks at
# would be the ones that go to the stores.
android/app/src/main/assets/public/
ios/App/App/public/

# @capacitor/assets also emits a PWA icon set and manifest. The site already
# has both (icon-*.png, app-manifest.json) and app.html names those; a second,
# unreferenced set is just files nobody updates.
icons/
manifest.json
