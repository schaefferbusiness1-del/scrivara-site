{
  "manifest_version": 3,
  "name": "MLS Assist",
  "version": "2.9.39",
  "version_name": "2.9.39+core-sha256:9aa37a568430b09947acc02fbb73b39b47df66757f88d29d74b7e772a887fb45",
  "description": "AI scribe + supervised autopilot for any web EMR. Captures visits, drafts notes, and acts on screen with your approval.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "webNavigation",
    "alarms",
    "system.display",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MLS Assist \u2014 settings",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://athenanet.athenahealth.com/*"
      ],
      "js": [
        "write_safety_guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://github.com/*",
        "*://*.github.com/*",
        "*://*.githubusercontent.com/*",
        "*://github.dev/*",
        "*://*.github.dev/*"
      ],
      "js": [
        "write_safety_guard.js",
        "review_screen.js",
        "content.js",
        "mls-popup.js",
        "ext_reviews_reader.js"
      ],
      "css": [
        "content.css",
        "mls-popup.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
