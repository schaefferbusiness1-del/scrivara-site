{
  "manifest_version": 3,
  "name": "MLS Assist",
  "version": "2.9.25",
  "version_name": "2.9.25+core-sha256:e13b86aa12c342c98d9c357029e322b4922d0e934c74f503b3c6cabe27050936",
  "description": "AI scribe + supervised autopilot for any web EMR. Captures visits, drafts notes, and acts on screen with your approval.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "webNavigation",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MLS Assist \u2014 settings",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://github.com/*",
        "*://*.github.com/*",
        "*://*.githubusercontent.com/*",
        "*://github.dev/*",
        "*://*.github.dev/*"
      ],
      "js": [
        "content.js",
        "mls-popup.js",
        "ext_reviews_reader.js"
      ],
      "css": [
        "content.css",
        "mls-popup.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
